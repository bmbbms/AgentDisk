# Database
DB_PASSWORD=your_db_password

# OSS (MinIO)
OSS_ACCESS_KEY=your_oss_access_key
OSS_SECRET_KEY=your_oss_secret_key

# Redis
REDIS_PASSWORD=your_redis_password

# JWT
JWT_SECRET=your_jwt_secret

# Gateway
GATEWAY_PORT=3100
GATEWAY_PUBLIC_URL=http://localhost:3100
GATEWAY_WEB_URL=http://localhost:9101
GATEWAY_DEFAULT_AGENT_ENDPOINT=http://localhost:8090/process
GATEWAY_OAUTH_CLIENT_ID=agentdisk
GATEWAY_OAUTH_CLIENT_SECRET=agentdisk-secret
GATEWAY_OAUTH_REDIRECT_URIS=http://localhost:9101/auth/callback,http://localhost:9100/auth/callback
GATEWAY_OAUTH_DEFAULT_REDIRECT_URI=http://localhost:9101/auth/callback
GATEWAY_OAUTH_SCOPES=openid,profile
